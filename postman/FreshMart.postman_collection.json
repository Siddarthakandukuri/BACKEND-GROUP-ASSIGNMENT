                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Sorted A to Z\", function () { const n = pm.response.json().map(s => s.name.toLowerCase()); pm.expect(n).to.eql([...n].sort()); });"
                ]
              }
